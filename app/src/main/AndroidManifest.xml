<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.eventosibirama">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Eventos Ibirama"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EventosIbirama">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".view.activity.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.EventosIbirama.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".view.activity.AuthActivity"
            android:exported="false"
            android:theme="@style/Theme.EventosIbirama.NoActionBar" />

        <activity
            android:name=".view.activity.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.EventosIbirama.NoActionBar" />

        <activity
            android:name=".view.activity.DetalhesEventoActivity"
            android:exported="false"
            android:theme="@style/Theme.EventosIbirama.NoActionBar" />


        <activity
            android:name=".view.activity.CadastroEventoActivity"
            android:exported="false"
            android:theme="@style/Theme.EventosIbirama.NoActionBar" />


        <activity
            android:name=".view.activity.EditarPerfilActivity"
            android:exported="false"
            android:theme="@style/Theme.EventosIbirama.NoActionBar" />


        <activity
            android:name=".view.activity.EventosProximosActivity"
            android:exported="false"
            android:theme="@style/Theme.EventosIbirama.NoActionBar" />

        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
